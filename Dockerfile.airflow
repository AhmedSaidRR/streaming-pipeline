FROM apache/airflow:2.10.5
# dbt lives in its own venv so its dependencies never clash with Airflow's.
#
# Both packages are pinned explicitly. Without the dbt-core pin, pip resolved
# dbt-postgres 1.8.2 against dbt-core 2.0.0rc10, which ships `dbt-oss` and refuses the
# postgres adapter ("set DBT_ALLOW_EXPERIMENTAL_ADAPTERS"). See VERIFICATION.md.
RUN python -m venv /home/airflow/dbt_venv \
 && /home/airflow/dbt_venv/bin/pip install --no-cache-dir --upgrade pip==24.2 \
 && /home/airflow/dbt_venv/bin/pip install --no-cache-dir \
        dbt-core==1.11.0 \
        dbt-postgres==1.11.0
