# Source: "simulated" (offline, reproducible, default) or "binance" (real public API, no key).
# Binance market-data endpoints are geo-blocked in some regions; simulated always works.
SOURCE=simulated
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT
POLL_INTERVAL_SEC=1
SIM_EXTRA_SYMBOLS=0

KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC=crypto.prices

# S3-compatible lake (SeaweedFS). Credentials must match infra/seaweedfs/s3.json.
# Local demo values only - never reuse them anywhere real.
S3_ENDPOINT=http://lake:8333
S3_ACCESS_KEY=lakeadmin
S3_SECRET_KEY=lakeadmin123
S3_BUCKET=datalake
S3_REGION=us-east-1

WH_USER=warehouse
WH_PASSWORD=warehouse
WH_DB=warehouse
WH_HOST=warehouse
WH_PORT=5432
